{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["@girs/gjs/ambient", "@girs/gnome-shell/ambient", "@girs/gnome-shell/extensions/global"]
  },
  "include": ["*.js", "tests/*.js"],
  "exclude": ["node_modules"]
}
